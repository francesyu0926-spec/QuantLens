{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuantLens",
  "version": "0.1.0",
  "identifier": "com.quantlens.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuantLens",
        "width": 1400,
        "height": 900,
        "resizable": true
      },
      {
        "label": "mini-ticker",
        "title": "QuantLens Ticker",
        "url": "index.html?mode=mini",
        "width": 340,
        "height": 88,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "signals",
        "title": "QuantLens 信号",
        "url": "index.html?mode=signals",
        "width": 420,
        "height": 640,
        "resizable": true,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/quantlens-engine"]
  }
}